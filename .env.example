# Telegram bot token (from @BotFather)
# ⚠️ NEVER commit the real value. Revoke leaked tokens immediately.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Port the embedded health server binds to (Render's default is 10000)
PORT=10000

# Source website being scraped (single source of truth)
SOURCE_BASE_URL=https://www.rareanimes.mov

# Optional: public URL for the keep-alive self-ping (set on Render only)
RENDER_EXTERNAL_URL=